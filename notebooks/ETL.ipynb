    "# SHAP Explain: Código completo corregido\n",
    "#1) Preparar entorno e imports\n",
    "%matplotlib inline\n",
    "import sys, os, pickle, json\n",
    "import pandas as pd, numpy as np, shap\n",
    "from shap.plots._waterfall import waterfall_legacy\n",
    "from IPython.display import display\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from inference.xgboost_explainer import SHAPExplainer\n",
    "\n",
    "project_root = r\"D:/breast_cancer_detection\"\n",
    "sys.path.append(project_root)\n",
    "\n",
    "#2) Rutas a artefactos y datos\n",
    "model_dir     = os.path.join(project_root, \"models/output/xgboost_modelo\")\n",
    "model_path    = os.path.join(model_dir, \"xgboost_modelo.pkl\")\n",
    "scaler_path   = os.path.join(model_dir, \"scaler.pkl\")\n",
    "features_path = os.path.join(model_dir, \"features.json\")\n",
    "parquet_train = r\"D:/TFM_CBIS/models/output/features/train_features.parquet\"\n",
    "parquet_val   = r\"D:/TFM_CBIS/models/output/features/val_features.parquet\"\n",
    "\n",
    "#3) Cargar modelo, scaler, encoder y features\n",
    "model        = pickle.load(open(model_path,  \"rb\"))\n",
    "scaler       = pickle.load(open(scaler_path, \"rb\"))\n",
    "label_enc    = pickle.load(open(os.path.join(model_dir, \"label_encoder.pkl\"), \"rb\"))\n",
    "feature_cols = json.load(open(features_path, \"r\", encoding=\"utf-8\"))\n",
    "\n",
    "#4) Preparar background para TreeExplainer\n",
    "df_train        = pd.read_parquet(parquet_train)\n",
    "X_train         = df_train[feature_cols].astype(float)\n",
    "X_train_scaled  = scaler.transform(X_train)\n",
    "background      = shap.sample(X_train_scaled, 100, random_state=42)\n",
    "\n",
    "#5) Seleccionar y preparar muestra de validación\n",
    "df_val = pd.read_parquet(parquet_val)\n",
    "# Elige la primera fila como ejemplo\n",
    "row = df_val.iloc[0]\n",
    "\n",
    "#5b) Definir el dict de entrada con las 7 features crudas\n",
    "input_data = {c: row[c] for c in feature_cols}\n",
    "\n",
    "#6) Escalar la muestra y predecir\n",
    "X_row        = pd.DataFrame([input_data], columns=feature_cols)\n",
    "X_row_scaled = scaler.transform(X_row)\n",
    "probs        = model.predict_proba(X_row_scaled)[0]\n",
    "pred_idx     = int(np.argmax(probs))\n",
    "pred_label   = label_enc.inverse_transform([pred_idx])[0]\n",
    "print(f\"Predicción: {pred_label} (clase {pred_idx}), confianza {probs[pred_idx]:.4f}\")\n",
    "\n",
    "#7) Explicabilidad SHAP con TreeExplainer\n",
    "explainer_te  = shap.TreeExplainer(model, background, feature_perturbation=\"interventional\")\n",
    "shap_values   = explainer_te.shap_values(X_row_scaled)\n",
    "\n",
    "# Componentes para waterfall_legacy\n",
    "sv = shap_values[pred_idx][0]\n",
    "ev = explainer_te.expected_value[pred_idx]\n",
    "fd = X_row_scaled[0]\n",
    "\n",
    "print(\"📝 Explicación SHAP (waterfall):\")\n",
    "display(waterfall_legacy(ev, sv, fd, feature_cols, max_display=7))"
   ]
  },

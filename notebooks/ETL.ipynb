    "import os\n",
    "import sys\n",
    "import joblib\n",
    "import pandas as pd\n",
    "import json\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "#  Añadir el path raíz del proyecto\n",
    "project_root = r\"D:/breast_cancer_detection\"\n",
    "sys.path.append(project_root)\n",
    "\n",
    "#  Definición mínima del clasificador\n",
    "class XGBoostClassifier:\n",
    "    def __init__(self):\n",
    "        self.model = None\n",
    "        self.scaler = None\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        return self.model.predict_proba(X)\n",
    "\n",
    "#  Rutas\n",
    "model_path = r\"D:/breast_cancer_detection/models/output/xgboost_modelo/xgboost_modelo.pkl\"\n",
    "scaler_path = r\"D:/breast_cancer_detection/models/output/xgboost_modelo/scaler.pkl\"\n",
    "encoder_path = r\"D:/breast_cancer_detection/models/output/xgboost_modelo/label_encoder.pkl\"\n",
    "features_json_path = r\"D:/breast_cancer_detection/models/output/xgboost_modelo/features.json\"\n",
    "parquet_path = r\"D:/TFM_CBIS/models/output/features/val_df_clean.parquet\"\n",
    "\n",
    "#  Cargar etiquetas\n",
    "if os.path.exists(encoder_path):\n",
    "    label_encoder = joblib.load(encoder_path)\n",
    "    label_list = label_encoder.inverse_transform([0, 1, 2])\n",
    "else:\n",
    "    LABEL_MAP = {\n",
    "        \"Benign\": 0,\n",
    "        \"Malignant\": 1,\n",
    "        \"Benign without callback\": 2\n",
    "    }\n",
    "    label_list = [label for label, idx in sorted(LABEL_MAP.items(), key=lambda x: x[1])]\n",
    "\n",
    "#  Cargar modelo y scaler\n",
    "strategy = XGBoostClassifier()\n",
    "strategy.model = joblib.load(model_path)\n",
    "\n",
    "loaded_scaler = joblib.load(scaler_path)\n",
    "if not isinstance(loaded_scaler, StandardScaler):\n",
    "    raise TypeError(\"❌ El archivo scaler.pkl no es un StandardScaler.\")\n",
    "strategy.scaler = loaded_scaler\n",
    "\n",
    "#  Cargar columnas desde JSON\n",
    "with open(features_json_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    feature_cols = json.load(f)\n",
    "\n",
    "#  Cargar archivo Parquet\n",
    "df = pd.read_parquet(parquet_path)\n",
    "\n",
    "#  Seleccionar las columnas originales del entrenamiento\n",
    "X = df[feature_cols]\n",
    "\n",
    "#  Escalar\n",
    "X_scaled = strategy.scaler.transform(X)\n",
    "\n",
    "#  Predicción\n",
    "probs = strategy.predict_proba(X_scaled)\n",
    "preds = probs.argmax(axis=1)\n",
    "labels = [label_list[p] for p in preds]\n",
    "\n",
    "#  Mostrar resultados\n",
    "for i in range(min(5, len(X))):\n",
    "    print(f\"\\n🖼️ Registro {i+1}\")\n",
    "    print(f\" - Predicción índice: {preds[i]}\")\n",
    "    print(f\" - Etiqueta clase: {labels[i]}\")\n",
    "    print(f\" - Confianza: {probs[i][preds[i]]:.4f}\")\n",
    "    print(f\" - Probabilidades: {probs[i]}\")"
   ]
  },
